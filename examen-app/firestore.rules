rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🔥 FUNCIÓN MEJORADA: Verificar autenticación
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // 🔥 FUNCIÓN MEJORADA: Verificar administrador
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // 🔥 FUNCIÓN MEJORADA: Verificar propietario
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 📂 USUARIOS - Reglas básicas
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();
    }

    // 📚 MATERIAS - Solo administradores pueden escribir, todos pueden leer
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ❓ PREGUNTAS - Solo administradores pueden escribir, todos pueden leer
    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 📝 GRUPOS DE PREGUNTAS - Solo administradores pueden escribir, todos pueden leer
    match /questionGroups/{groupId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 📋 EXÁMENES - Solo administradores pueden escribir, todos pueden leer
    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 🎯 INTENTOS - Reglas específicas por usuario
    match /attempts/{attemptId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // 🚫 DENEGAR TODO LO DEMÁS
    match /{document=**} {
      allow read, write: if false;
    }
  }
}